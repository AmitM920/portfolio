<style>
  .skills {
    padding: 0 clamp(24px, 5.55vw, 80px) 150px;
  }
  .section-intro {
    text-align: center;
  }
  h2 {
    margin: 0;
    color: #fefefe;
    font-size: clamp(30px, 3.2vw, 40px);
  }
  .section-intro p {
    margin: 14px 0 0;
    color: #707070;
    font-size: 16px;
  }
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(100px, 1fr));
    gap: 26px;
    max-width: 1280px;
    margin: 52px auto 0;
  }
  .skill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    color: #959595;
    text-align: center;
  }
  .skill-circle {
    position: relative;
    display: grid;
    place-items: center;
    width: 130px;
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .skill-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .skill-ring-track,
  .skill-ring-progress {
    fill: none;
    stroke-width: 8;
  }
  .skill-ring-track {
    stroke: #2e2e2e;
  }
  .skill-ring-progress {
    stroke: #fd6f00;
    stroke-linecap: round;
  }
  .skill-icon {
    position: relative;
    z-index: 1;
    width: 60px;
    height: 60px;
    object-fit: contain;
  }
  .skill-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-weight: 700;
  }
  .skill-meta span {
    background: linear-gradient(98deg, #fd6f00 3.1%, #e46400 94.54%);
    background-clip: text;
    color: transparent;
    font-size: 30px;
  }
  .skill-meta strong {
    color: #959595;
    font-size: 24px;
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .skills {
      padding-bottom: 90px;
    }
    .skill-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 12px;
    }
    .skill:last-child {
      grid-column: 1 / -1;
    }
  }
</style>
